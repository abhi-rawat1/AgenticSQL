# Which provider: groq | openrouter | nvidia | ollama (local, no key needed)
PROVIDER=groq
# Key is needed if need to use the LLM API. Set it in the .env file or as an environment variable.
GROQ_API_KEY=  
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

CONTEXT_TOKENS=16000
KEEP_TURNS=3

DB_PASSWORD=
DB_SCHEMA=aidemo

# Set your OpenAI API key here or as an environment variable. This is needed if using LLM non-API pattern.
OPENAI_API_KEY=