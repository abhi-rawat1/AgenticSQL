POSTGRES_URL=postgresql+psycopg://postgres:your_secure_password@prod-db-host:5432/postgres
DB_SCHEMA=ecommerce
OPENAI_API_KEY=your_production_openai_key_here
MODEL_NAME=gpt-4o-mini
ALLOWED_TABLES=customers,orders,order_items,products,returns,refunds,inventory,shipments
APPROVAL_REQUIRED_ACTIONS=refund_order,create_return,cancel_order,update_inventory
LOG_DIR=/var/log/customersupportassist
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
APP_ENV=prod
